# ============================================================
# 物流知识库 RAG 配置示例
# 默认值完全离线：哈希向量 + 抽取式回答，不需要 API Key。
# 复制为 .env 后按需修改；程序只读取环境变量，不自动加载 .env。
# ============================================================

# 数据库与检索
KB_DB_PATH=data/kb.sqlite3
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONTEXT_CHARS=6000
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# 向量：hash（默认，离线）或 http（OpenAI 兼容 /embeddings）
EMBED_PROVIDER=hash
EMBED_DIM=512
EMBED_SALT=lkb-hash-v1
EMBED_BATCH_SIZE=16
# EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v4

# 生成：mock（默认，离线抽取式）或 http（OpenAI 兼容 chat completions）
LLM_PROVIDER=mock
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# 重排：off / heuristic（默认） / http
RERANK_PROVIDER=heuristic
RERANK_FALLBACK=true
# RERANK_API_BASE=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
